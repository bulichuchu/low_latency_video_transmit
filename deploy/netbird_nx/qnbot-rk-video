#!/bin/bash
# NX only: keep the proven RK <-> Mac UDP/5004 rules ahead of NetBird/Docker.
set -euo pipefail

ipt=(iptables -w 5)
out=(-i enP8p1s0 -o wt0 -s 192.168.168.168/32 -d 100.67.196.150/32 -p udp --dport 5004)
reply=(-i wt0 -o enP8p1s0 -s 100.67.196.150/32 -d 192.168.168.168/32 -p udp --sport 5004 -m conntrack --ctstate ESTABLISHED)
nat=(-s 192.168.168.168/32 -d 100.67.196.150/32 -o wt0 -p udp --dport 5004)
out_rule=("${out[@]}" -m comment --comment qnbot-rk-video-out -j ACCEPT)
reply_rule=("${reply[@]}" -m comment --comment qnbot-rk-video-reply -j ACCEPT)
nat_rule=("${nat[@]}" -m comment --comment qnbot-rk-video-nat -j MASQUERADE)

rule_exists() {
    local table=$1 chain=$2 result status
    shift 2
    if result=$("${ipt[@]}" -t "$table" -C "$chain" "$@" 2>&1); then
        return 0
    else
        status=$?
        if [[ $status != 1 ]]; then
            printf 'iptables check failed (%s): %s\n' "$status" "$result" >&2
            exit "$status"
        fi
        return 1
    fi
}

remove_exact() {
    local table=$1 chain=$2
    shift 2
    while rule_exists "$table" "$chain" "$@"; do
        "${ipt[@]}" -t "$table" -D "$chain" "$@"
    done
}

remove_legacy() {
    # Adopt only the three exact, uncommented rules used in the manual test.
    remove_exact filter FORWARD "${out[@]}" -j ACCEPT
    remove_exact filter FORWARD "${reply[@]}" -j ACCEPT
    remove_exact nat POSTROUTING "${nat[@]}" -j MASQUERADE
}

case "${1:-apply}" in
    remove)
        # Read both tables first: backend/permission errors must not be hidden.
        "${ipt[@]}" -t filter -S FORWARD >/dev/null
        "${ipt[@]}" -t nat -S POSTROUTING >/dev/null
        remove_exact filter FORWARD "${out_rule[@]}"
        remove_exact filter FORWARD "${reply_rule[@]}"
        remove_exact nat POSTROUTING "${nat_rule[@]}"
        remove_legacy
        exit 0
        ;;
    apply) ;;
    *) echo "Usage: $0 [apply|remove]" >&2; exit 2 ;;
esac

# systemd serializes this oneshot service, including manual systemctl starts.
# Never flush a chain or restore the whole firewall: other services own it too.
forward=$("${ipt[@]}" -t filter -S FORWARD)
postrouting=$("${ipt[@]}" -t nat -S POSTROUTING)
first=$(printf '%s\n' "$forward" | awk '$1 == "-A" && ++n == 1 {print}')
second=$(printf '%s\n' "$forward" | awk '$1 == "-A" && ++n == 2 {print}')
nat_first=$(printf '%s\n' "$postrouting" | awk '$1 == "-A" && ++n == 1 {print}')

if ! { [[ "$nat_first" == *qnbot-rk-video-nat* ]] &&
       rule_exists nat POSTROUTING "${nat_rule[@]}"; }; then
    remove_exact nat POSTROUTING "${nat_rule[@]}"
    "${ipt[@]}" -t nat -I POSTROUTING 1 "${nat_rule[@]}"
    echo 'Restored RK video NAT.'
fi

if ! { [[ "$first" == *qnbot-rk-video-reply* && "$second" == *qnbot-rk-video-out* ]] &&
       rule_exists filter FORWARD "${reply_rule[@]}" &&
       rule_exists filter FORWARD "${out_rule[@]}"; }; then
    remove_exact filter FORWARD "${reply_rule[@]}"
    remove_exact filter FORWARD "${out_rule[@]}"
    "${ipt[@]}" -t filter -I FORWARD 1 "${out_rule[@]}"
    "${ipt[@]}" -t filter -I FORWARD 1 "${reply_rule[@]}"
    echo 'Restored RK video forwarding rules.'
fi

remove_legacy
